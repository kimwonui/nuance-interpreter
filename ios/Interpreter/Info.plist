<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>NUA</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>0.1.0</string>
	<key>CFBundleVersion</key>
	<string>2</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>InterpreterAppKey</key>
	<string>$(INTERPRETER_APP_KEY)</string>
	<key>InterpreterServerURL</key>
	<string>$(INTERPRETER_SERVER_URL)</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
	<key>NSCameraUsageDescription</key>
	<string>NUA never uses the camera. Its voice connection library can also carry video, so iOS requires this note; NUA does not turn video on.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>During development, NUA connects to the interpretation server on your local network.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>NUA uses the microphone to interpret what you say. Audio is not saved.</string>
	<key>UIAppFonts</key>
	<array>
		<string>NotoSansKR_400Regular.ttf</string>
		<string>NotoSansKR_500Medium.ttf</string>
		<string>NotoSansKR_700Bold.ttf</string>
	</array>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string></string>
	</dict>
	<key>UIRequiresFullScreen</key>
	<true/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
</dict>
</plist>
